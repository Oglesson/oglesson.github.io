# Copy this file to .env and fill in your values.
# .env must be gitignored - EBAY_CLIENT_SECRET is a credential.

# From https://developer.ebay.com/my/keys
# Use the PRODUCTION keyset's "App ID (Client ID)" and "Cert ID (Client Secret)".
EBAY_CLIENT_ID=YourApp-YourAppN-PRD-abc123def-45678901
EBAY_CLIENT_SECRET=PRD-abc123def456-7890-1234-abcd-ef01

# Your eBay username, exactly as it appears on your listings.
EBAY_SELLER_ID=your_ebay_username

# EBAY_US, EBAY_GB, EBAY_DE, EBAY_AU, EBAY_CA ...
EBAY_MARKETPLACE_ID=EBAY_US

# How long to cache listings, in milliseconds. Default 600000 (10 minutes).
# eBay's default Browse API allowance is 5,000 calls/day, so don't set this too low.
EBAY_CACHE_TTL_MS=600000

# Optional. Set to "sandbox" to hit api.sandbox.ebay.com instead of production.
# EBAY_ENV=sandbox

# Optional. Your eBay Partner Network campaign ID. If set, listing links become
# affiliate links and you earn commission on sales you refer to your own store.
# EBAY_CAMPAIGN_ID=5338012345
